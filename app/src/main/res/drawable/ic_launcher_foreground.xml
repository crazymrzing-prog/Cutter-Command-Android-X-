<?xml version="1.0" encoding="utf-8"?>
<!-- Simplified captain's-hat + red cutter/blade-holder silhouette, in the
     red/black/gold palette. An original design - no logos, wordmarks, or
     branding from any manufacturer. Content is scaled to sit within the
     108dp canvas's inner ~66dp safe zone so adaptive-icon masking on
     different launchers doesn't clip it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- red cylinder (blade holder) body -->
