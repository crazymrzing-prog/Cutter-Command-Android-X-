        android:pathData="M42.75,49.125 H65.25 A4.5,4.5 0 0 1 69.75,53.625 V73.125 A4.5,4.5 0 0 1 65.25,77.625 H42.75 A4.5,4.5 0 0 1 38.25,73.125 V53.625 A4.5,4.5 0 0 1 42.75,49.125 Z"
        android:fillColor="#B0161E" />

    <!-- darker grip band through the middle -->
    <path
        android:pathData="M38.25,61.125 H69.75 V68.625 H38.25 Z"
        android:fillColor="#780E14" />

    <!-- blade tip -->
    <path
        android:pathData="M50.25,77.625 L57.75,77.625 L54,86.625 Z"
        android:fillColor="#D6D6D6" />

    <!-- hat brim -->
    <path
        android:pathData="M34.5,44.625 H73.5 A3,3 0 0 1 76.5,47.625 V48.375 A3,3 0 0 1 73.5,51.375 H34.5 A3,3 0 0 1 31.5,48.375 V47.625 A3,3 0 0 1 34.5,44.625 Z"
