        android:pathData="M35.6,41.25 H72.4 A1.1,1.1 0 0 1 73.5,42.375 A1.1,1.1 0 0 1 72.4,43.5 H35.6 A1.1,1.1 0 0 1 34.5,42.375 A1.1,1.1 0 0 1 35.6,41.25 Z"
